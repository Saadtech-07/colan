# Auth.js / NextAuth — use a long random value in production (e.g. openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters

# MongoDB Atlas or local — paste your connection string from Atlas Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=colan_teams

# Optional: canonical URL for Auth.js (e.g. https://colan.example.com or http://localhost:3000)
AUTH_URL=
