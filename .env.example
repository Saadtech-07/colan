# Copy to .env and fill in your Atlas values.
# https://www.mongodb.com/docs/atlas/driver-connection/

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=colan_teams

# NextAuth / Auth.js — use a long random string (e.g. openssl rand -base64 32)
# AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Public app URL used in onboarding emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail / Nodemailer delivery
EMAIL_USER=mohammedsaad1918@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=Colan Infotech <colan.info@gmail.com>

# Seating AI — OpenRouter is used first when this key is set (recommended)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
SEATING_AI_PROVIDER=openrouter
# OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
# OPENROUTER_TEXT_MODEL_FALLBACK=google/gemini-2.5-flash
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# OPENROUTER_VISION_MODEL_FALLBACK=openai/gpt-4o-mini
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_TIMEOUT_MS=90000
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=Colan Teams

# OpenAI — optional fallback only (or set SEATING_AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_TIMEOUT_MS=90000
